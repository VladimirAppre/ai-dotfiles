# .env.example — document what variables are needed for this server
# Copy this to .env (gitignored) and fill in real values
# Never commit .env — it stays local only

# Database
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# App secrets
APP_SECRET_KEY=
API_KEY=

# External services
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Monitoring
SENTRY_DSN=
